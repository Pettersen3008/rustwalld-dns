{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "test-results/**", "playwright-report/**"],
  "rules": {
    "react/rules-of-hooks": "error"
  }
}
